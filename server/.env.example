# 微信支付（积分充值）
# 开发联调默认走模拟支付；正式接入请设为 0 并填写下方商户信息
WECHAT_PAY_MOCK=1

# 微信商户号
WECHAT_MCH_ID=
# 公众号 AppID（须与商户号绑定，且用于 JSAPI / 网页授权）
WECHAT_APP_ID=
# 公众号 AppSecret（微信公众平台 → 开发 → 基本配置；JSAPI 换 openid 必需）
WECHAT_APP_SECRET=
# API v3 密钥（32 位）
WECHAT_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_CERT_SERIAL_NO=
# 商户私钥路径（默认 server/certs/apiclient_key.pem）
WECHAT_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# 平台证书缓存目录（仅「平台证书模式」需要；公钥模式可忽略）
WECHAT_CERT_DIR=./certs
# 微信支付公钥模式（2024.09 后新商户常见）：后台「API安全 → 微信支付公钥」
WECHAT_PUBLIC_KEY_PATH=./certs/pub_key.pem
# 形如：PUB_KEY_ID_011748282068...
WECHAT_PUBLIC_KEY_ID=
# 支付结果回调（须公网 HTTPS）
# WECHAT_NOTIFY_URL=https://adflow.chat/api/billing/wechat/notify
WECHAT_NOTIFY_URL=

# 阿里云 OSS（生成视频上传；对象需可公共读以便前端直接播放）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=man-shan-agent
# 可选自定义 CDN / 域名，例如 https://cdn.example.com
# OSS_PUBLIC_BASE_URL=
